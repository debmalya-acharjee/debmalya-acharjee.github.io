---
const { project } = Astro.props;
---
<article class="project-card">
  <div class="project-top">
    <span class="project-category">{project.category}</span>
    {project.status && <span class="project-status"><i></i>{project.status}</span>}
  </div>
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <div class="skill-tags small">
    {project.technologies.map((tech: string) => <span>{tech}</span>)}
  </div>
  <div class="project-actions">
    <a href={`/projects/${project.slug}/`}>Open case study →</a>
    <a href={project.github} target="_blank">Repository ↗</a>
  </div>
</article>
